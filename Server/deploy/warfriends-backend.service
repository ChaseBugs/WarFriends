[Unit]
Description=WarFriends ASP.NET Core backend
After=network-online.target
Wants=network-online.target

[Service]
User=warfriends
Group=warfriends
WorkingDirectory=/opt/warfriends/backend
ExecStart=/usr/bin/dotnet /opt/warfriends/backend/War.Backend.dll
EnvironmentFile=/etc/warfriends/backend.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
