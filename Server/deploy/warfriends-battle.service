[Unit]
Description=WarFriends protobuf UDP battle host
After=network-online.target
Wants=network-online.target

[Service]
User=warfriends
Group=warfriends
WorkingDirectory=/opt/warfriends/battle
ExecStart=/usr/bin/dotnet /opt/warfriends/battle/War.BattleServer.dll
EnvironmentFile=/etc/warfriends/battle.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
