{
  "name": "warfriends-gameserver",
  "version": "0.1.0",
  "description": "Private backend (REST meta server + WebSocket match relay) for the recovered WarFriends Unity client.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:weapon-catalog": "powershell -NoProfile -ExecutionPolicy Bypass -File ../Tools/Extract-WeaponCatalog.ps1 -Check",
    "generate:weapon-upgrades": "node scripts/Extract-WeaponUpgradeCatalog.mjs",
    "verify:weapon-upgrades": "node scripts/Extract-WeaponUpgradeCatalog.mjs --check",
    "verify:unit-catalog": "powershell -NoProfile -ExecutionPolicy Bypass -File ../Tools/Extract-UnitCatalog.ps1 -Check",
    "generate:army-power": "node scripts/Extract-ArmyPowerCatalog.mjs",
    "verify:army-power": "node scripts/Extract-ArmyPowerCatalog.mjs --check",
    "generate:visual-catalog": "node scripts/Extract-VisualCatalog.mjs",
    "verify:visual-catalog": "node scripts/Extract-VisualCatalog.mjs --check",
    "generate:card-catalog": "node scripts/Extract-CardCatalog.mjs",
    "verify:card-catalog": "node scripts/Extract-CardCatalog.mjs --check",
    "sync:catalog": "npm run build && node --env-file=.env dist/scripts/syncGameCatalog.js",
    "audit:squads": "npm run build && node --env-file=.env dist/scripts/auditSquadIntegrity.js",
    "repair:squads": "npm run build && node --env-file=.env dist/scripts/auditSquadIntegrity.js --repair",
    "test": "npm run build && node --test \"dist/tests/*.test.js\""
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.21.0",
    "winston": "^3.14.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
