# Copy to .env and adjust for your environment.
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080

# MongoDB (native driver). A replica set is required by cross-player economy transactions.
# A local single-node deployment can use rs0 after running rs.initiate() once.
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB_NAME=warfriends
MONGO_POOL_SIZE=100

# Off-host backup destination must be a mounted remote volume or UNC share. The encryption key is
# a canonical Base64 encoding of 32 random bytes; keep old keys while their archives are retained.
# Example key generation: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
BACKUP_OFFHOST_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# Redis (optional — matchmaking queue, leaderboards, socket presence). Set false to run Mongo-only.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_SESSION_TTL=1800
REDIS_LEADERBOARD_TTL=15

# Auth: active HMAC/pepper key. Production requires at least 32 characters.
AUTH_SECRET=change-me-in-production
# Temporary comma-separated verification keys for staged AUTH_SECRET rotation. New digests always
# use AUTH_SECRET; successful password/provider logins migrate old digests. Maximum three keys.
# Existing gameplay session tokens are stored opaquely and remain valid without this setting.
AUTH_SECRET_FALLBACKS=
# Versioned custom-password scrypt N factor. Must be a power of two from 16384 through 65536.
# Raising it preserves old digests and upgrades them after their next successful password login.
AUTH_SCRYPT_COST=16384
# Independent bearer secret for /admin and /metrics. Production startup requires at least 32 chars.
ADMIN_SECRET=change-this-admin-secret-in-production
# Persistent per-identity LoginToCustomAccount throttle. Values must be exact integers:
# attempts 2-100, window 60-86400 seconds, lockout 60-604800 seconds. Successful login clears
# its own reservation; ordinary gameplay session checks do not consume this allowance.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900

# Exact integer HTTP token bucket: requests 1-100000, window 1-86400, entries 100-1000000.
# Keep TRUST_PROXY_HOPS=0 for direct deployments; set it only to the
# exact number of trusted reverse-proxy hops so clients cannot spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0
HTTP_RATE_LIMIT_MAX_REQUESTS=120
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_ENTRIES=10000

# Exact integer WebSocket boundary: payload 1024-1048576, messages 1-100000,
# window 1-86400, violations 1-100. Normal PvP/chat envelopes are far below 64 KiB.
WEBSOCKET_MAX_PAYLOAD_BYTES=65536
WEBSOCKET_RATE_LIMIT_MESSAGES=120
WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=10
WEBSOCKET_RATE_LIMIT_MAX_VIOLATIONS=3
# Exact 10-3600 seconds; this also participates in renewable lease sizing.
PLAYER_LEAGUE_SCHEDULER_INTERVAL_SECONDS=60

# Real-money purchases stay disabled until Google Play Developer API credentials are installed.
# Set GOOGLE_APPLICATION_CREDENTIALS to the service-account JSON file outside the repository.
GOOGLE_PLAY_PURCHASES_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.chillingo.warfriends.android.gplay
PURCHASE_TOKEN_HASH_SECRET=replace-with-a-separate-random-secret
# Stable independent key for AES-GCM subscription-token storage. Rotating it requires decrypting
# and re-encrypting the ledger first; losing it prevents future status checks but not login.
PURCHASE_TOKEN_ENCRYPTION_SECRET=replace-with-another-separate-random-secret
# Defaults to the purchase enablement value. The poll finds due rows; each successful row is
# normally checked every six hours or at its known expiry, whichever occurs first.
GOOGLE_PLAY_SUBSCRIPTION_REVALIDATION_ENABLED=false
# Exact 30-3600 seconds between leased subscription sweeps.
GOOGLE_PLAY_SUBSCRIPTION_SCHEDULER_INTERVAL_SECONDS=300
# Exact 300-86400 seconds; receipt creation and every later provider check share this value.
GOOGLE_PLAY_SUBSCRIPTION_REVALIDATION_CADENCE_SECONDS=21600
# Exact 1-1000 complete receipts selected per sweep.
GOOGLE_PLAY_SUBSCRIPTION_REVALIDATION_BATCH_SIZE=100
# Delayed authoritative backstop for refunded/charged-back one-time products. The sweep uses a
# durable cursor, a ten-minute overlap, and Google's maximum 30-day first-run lookback.
GOOGLE_PLAY_VOIDED_PURCHASE_RECONCILIATION_ENABLED=false
# Exact 60-3600 seconds between leased voided-purchase sweeps.
GOOGLE_PLAY_VOIDED_PURCHASE_SCHEDULER_INTERVAL_SECONDS=300

# Optional signed remote Google2u publication. Empty retains the APK-bundled sheets. Sign the
# reviewed JSON with `npm run sign:remote-config -- config/remote-configuration.json` before boot.
REMOTE_CONFIGURATION_MANIFEST_PATH=
REMOTE_CONFIGURATION_SIGNING_SECRET=replace-with-a-separate-random-signing-secret

# Exact integer replacement-client compatibility gate from 0 through 2147483647.
# Zero disables the gate. The stock client continues to use its separate dotted Version field.
MIN_CLIENT_VERSION=0

# Exact compatibility assertions recovered from the client Constants sheet. Changing either value
# is unsupported because the stock client independently calculates energy with 900 seconds / 5 tags.
DOG_TAG_REFILL_SECONDS=900
DOG_TAG_CAP=5
# Offline daily-calendar Gold is immutable startup authority. Values must be exact nonnegative
# JavaScript-safe integers, and the weekly amount must be at least the ordinary amount.
DAILY_REWARD_GOLD=5
DAILY_REWARD_WEEKLY_GOLD=10
# Currency-only assignment mega-reward fallback, resolved immutably during startup. The value must
# be an exact nonnegative JavaScript-safe integer; the retired production/non-currency table is unknown.
ASSIGNMENT_MEGA_REWARD_GOLD=25
# Original live backend supplied this duration; seven days is reconstruction policy. It is resolved
# immutably at startup and must be an exact nonnegative C# signed-int number of seconds.
STARTER_ASSIGNMENT_DURATION_SECONDS=604800
# Retired remote A/B config selected `warbucks` or `bwarbucks`. This immutable startup policy must
# be the exact case-sensitive literal `standard` or `b`; whitespace/case normalization is rejected.
WARBUCKS_GOLD_VARIANT=standard

# Optional reviewed Squad Event schedule. Empty means action 113 is safely disabled because
# the retired production season/reward document was not recovered from either APK.
SQUAD_EVENT_CONFIG_PATH=
# Reconstruction-owned weekly UTC calendar. Keep the duration stable after seasons exist.
SQUAD_WARS_ENABLED=true
SQUAD_WARS_SEASON_DURATION_SECONDS=604800
# Cross-node maintenance uses a MongoDB lease; this must be an exact 10-3600-second interval and
# also participates in renewable lease sizing.
SQUAD_WARS_SCHEDULER_INTERVAL_SECONDS=60

# Optional reviewed EventAssignmentManager daily-event schedule. This is separate from Squad
# Events. Empty keeps its boot config hidden and actions 222/223 disabled.
EVENT_ASSIGNMENT_CONFIG_PATH=

# War Arena live document fallback. Prices/rewards were remote data and must be replaced
# when an archived production arena configuration is available.
ARENA_ID_PREFIX=offline-arena
ARENA_MAX_BATTLES=12
ARENA_LIVES=3
ARENA_ENTRY_TICKETS=1
ARENA_ENTRY_GOLD=30
ARENA_HEART_TICKETS=1
ARENA_HEART_GOLD=30
ARENA_GUARANTEED_SCRAPS=10

# Persistent inbox controls. Challenge TTL must be an exact integer from 60 through 604800 seconds.
CHALLENGE_TTL_SECONDS=86400
# Exact 1-1000 direct/challenge attempts per fixed one-minute window.
OUTGOING_MESSAGES_PER_MINUTE=20
# Exact 1-100 reports per fixed one-hour window.
REPORT_MAX_PER_HOUR=5
# Terminal moderation records are previewed/exported before an explicit admin purge. Account
# sanctions are intentionally retained indefinitely and are never selected by this policy.
MODERATION_REPORT_RETENTION_DAYS=365
MODERATION_APPEAL_RETENTION_DAYS=365
PROFANITY_EXTRA_TERMS=

# Persistent Squad Chat replacement. History 3 is the exact recovered MainScene value.
# Exact 1-100 messages per authenticated history page.
SQUAD_CHAT_HISTORY_LIMIT=3
# Exact 1-365 whole days, matching durable message authority.
SQUAD_CHAT_RETENTION_DAYS=30
# Exact 1-1000 attempts per atomic sender/minute window.
SQUAD_CHAT_MESSAGES_PER_MINUTE=10
# Exact 1-2048 characters, matching durable row authority.
SQUAD_CHAT_MAX_LENGTH=256

# Realtime match relay
# Exact positive seconds a player may sit in the matchmaking queue before a timeout/bot fallback.
# The value times 1000 must fit Node's 2,147,483,647-millisecond timer range.
MATCHMAKING_TIMEOUT=30
# Exact positive seconds both paired clients have to join their newly created room; the same
# Node timer-range limit applies.
MATCH_JOIN_TIMEOUT_SECONDS=30
# Exact positive seconds an active player may reconnect before the match becomes a forfeit; the
# same Node timer-range limit applies.
MATCH_DISCONNECT_GRACE_SECONDS=20
# Give two simultaneous stock GameEnded requests time to reach durable consensus. This must be an
# exact integer from 0 through 15000 milliseconds. Zero returns pending immediately.
MATCH_RESULT_CONSENSUS_WAIT_MS=5000

# Offline replacement for the retired Fusebox BattleWarbucksRewards Win/Loss document.
# Exact nonnegative integer values must remain within C# signed-int width after the independent
# 1.5x VIP multiplier (maximum base 1431655765). Client-echoed values are ignored.
PVP_WIN_WARBUCKS=800
PVP_LOSE_WARBUCKS=400

# Offline action-199 reward policy. The archived Instant Battle reward table is unavailable.
# Exact nonnegative per-battle integers must be at most 429496729 so a full five-charge batch
# fits the recovered C# signed-int response; charge timing and Gold prices remain source-fixed.
INSTANT_BATTLE_XP_PER_BATTLE=20
INSTANT_BATTLE_WARBUCKS_PER_BATTLE=600

# Offline normal battle reward for one successful Daily, Co-op, or Heroic mission.
# Completion-chain Gold/Tickets/Scraps still come from the exact MainScene MissionsRewards rows.
MISSION_SUCCESS_XP=30
MISSION_SUCCESS_WARBUCKS=800
