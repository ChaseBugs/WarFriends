# Documentation only: .NET does not automatically load this file.
# Set process environment variables, or use a systemd EnvironmentFile on Linux.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:8080
Mongo__Uri=mongodb://127.0.0.1:27017
Mongo__Database=warfriends
# Generate a random base64 32-byte key. Set the same value in both processes.
Battle__SigningKey=
Battle__ServerId=local-1
Battle__PublicHost=127.0.0.1
Battle__BindAddress=127.0.0.1
Battle__Port=30000
# Optional unscored matches: choose one file OR a directory with 1-32 manifests.
# Battle__MatchManifestPath=/absolute/path/match.json
# Battle__MatchManifestDirectory=/absolute/path/matches
# Battle__ContentPath=/absolute/path/Server/content/recovered-battle-content.json
# Legacy channel for the recovered 1.4.0 Unity client (/index_09_25_2015.php, /check.php).
# Server-owned starting state; the client's own StartingGold/StartingWarbucks are discarded.
Legacy__Starter__Gold=500
Legacy__Starter__WarBucks=50
Legacy__Starter__DogTagMax=10
Legacy__Starter__SessionLifetimeHours=24
# Sheet-configuration version reported to GetConfigurations. Bump only alongside real sheet
# documents in the response, or the client re-downloads nothing and logs a mismatch.
Legacy__Starter__SheetConfiguration=0
# Serves the legacy channel over plain HTTP, exposing credentials and session tokens.
# Offline/isolated networks only. Leave unset in any reachable deployment.
Legacy__AllowInsecureHttp=false
