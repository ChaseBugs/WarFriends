# Documentation only: .NET does not automatically load this file.
# Set process environment variables, or use a systemd EnvironmentFile on Linux.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:8080
Mongo__Uri=mongodb://127.0.0.1:27017
Mongo__Database=warfriends
# Generate a random base64 32-byte key. Set the same value in both processes.
Battle__SigningKey=
Battle__ServerId=local-1
Battle__PublicHost=127.0.0.1
Battle__BindAddress=127.0.0.1
Battle__Port=30000
