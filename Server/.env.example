# Copy to .env and adjust for your environment.
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080

# MongoDB (native driver). A replica set is required by cross-player economy transactions.
# A local single-node deployment can use rs0 after running rs.initiate() once.
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB_NAME=warfriends
MONGO_POOL_SIZE=100

# Redis (optional — matchmaking queue, leaderboards, socket presence). Set false to run Mongo-only.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_SESSION_TTL=1800
REDIS_LEADERBOARD_TTL=15

# Auth: HMAC secret for the id+token credential the client reuses after CreateAccount.
AUTH_SECRET=change-me-in-production
# Independent bearer secret for /admin and /metrics. Production startup requires at least 32 chars.
ADMIN_SECRET=change-this-admin-secret-in-production
# Persistent per-identity LoginToCustomAccount throttle. Successful login clears its own
# reservation; ordinary gameplay session checks do not consume this allowance.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900

# Global HTTP token bucket. Keep TRUST_PROXY_HOPS=0 for direct deployments; set it only to the
# exact number of trusted reverse-proxy hops so clients cannot spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0
HTTP_RATE_LIMIT_MAX_REQUESTS=120
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_ENTRIES=10000

# Replacement WebSocket hub boundary. Normal PvP/chat envelopes are far below 64 KiB.
WEBSOCKET_MAX_PAYLOAD_BYTES=65536
WEBSOCKET_RATE_LIMIT_MESSAGES=120
WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=10
WEBSOCKET_RATE_LIMIT_MAX_VIOLATIONS=3
PLAYER_LEAGUE_SCHEDULER_INTERVAL_SECONDS=60

# Client compatibility gate. The client sends its build version; set the minimum you accept (0 = allow all).
MIN_CLIENT_VERSION=0

# Economy balancing recovered from the client Constants sheet.
DOG_TAG_REFILL_SECONDS=900
DOG_TAG_CAP=5
DAILY_REWARD_GOLD=5
DAILY_REWARD_WEEKLY_GOLD=10
ASSIGNMENT_MEGA_REWARD_GOLD=25
# Original live backend supplied this deadline; the recovered client only consumes it.
STARTER_ASSIGNMENT_DURATION_SECONDS=604800
# Retired remote A/B config selected `warbucks` or `bwarbucks`; valid values are standard/b.
WARBUCKS_GOLD_VARIANT=standard

# Optional reviewed Squad Event schedule. Empty means action 113 is safely disabled because
# the retired production season/reward document was not recovered from either APK.
SQUAD_EVENT_CONFIG_PATH=

# Optional reviewed EventAssignmentManager daily-event schedule. This is separate from Squad
# Events. Empty keeps its boot config hidden and actions 222/223 disabled.
EVENT_ASSIGNMENT_CONFIG_PATH=

# War Arena live document fallback. Prices/rewards were remote data and must be replaced
# when an archived production arena configuration is available.
ARENA_ID_PREFIX=offline-arena
ARENA_MAX_BATTLES=12
ARENA_LIVES=3
ARENA_ENTRY_TICKETS=1
ARENA_ENTRY_GOLD=30
ARENA_HEART_TICKETS=1
ARENA_HEART_GOLD=30
ARENA_GUARANTEED_SCRAPS=10

# Persistent inbox controls.
CHALLENGE_TTL_SECONDS=86400
OUTGOING_MESSAGES_PER_MINUTE=20
REPORT_MAX_PER_HOUR=5
PROFANITY_EXTRA_TERMS=

# Persistent Squad Chat replacement. History 3 is the exact recovered MainScene value.
SQUAD_CHAT_HISTORY_LIMIT=3
SQUAD_CHAT_RETENTION_DAYS=30
SQUAD_CHAT_MESSAGES_PER_MINUTE=10
SQUAD_CHAT_MAX_LENGTH=256

# Realtime match relay
# Seconds a player may sit in the matchmaking queue before a timeout/bot fallback.
MATCHMAKING_TIMEOUT=30
# Seconds both paired clients have to join their newly created room.
MATCH_JOIN_TIMEOUT_SECONDS=30
# Seconds an active player may reconnect before the match becomes a forfeit.
MATCH_DISCONNECT_GRACE_SECONDS=20
# Give two simultaneous stock GameEnded requests time to reach durable consensus. Set 0 to
# return pending immediately; keep this bounded because it occupies one HTTP request slot.
MATCH_RESULT_CONSENSUS_WAIT_MS=5000

# Offline replacement for the retired Fusebox BattleWarbucksRewards Win/Loss document.
# The backend ignores client-echoed WarbuckRewardWin and WarbuckRewardLoss values.
PVP_WIN_WARBUCKS=800
PVP_LOSE_WARBUCKS=400

# Offline action-199 reward policy. The archived Instant Battle reward table is unavailable;
# charge timing and Gold prices remain fixed to the recovered client contract.
INSTANT_BATTLE_XP_PER_BATTLE=20
INSTANT_BATTLE_WARBUCKS_PER_BATTLE=600

# Offline normal battle reward for one successful Daily, Co-op, or Heroic mission.
# Completion-chain Gold/Tickets/Scraps still come from the exact MainScene MissionsRewards rows.
MISSION_SUCCESS_XP=30
MISSION_SUCCESS_WARBUCKS=800
