# Documentation only: .NET does not automatically load this file.
# Set process environment variables, or use a systemd EnvironmentFile on Linux.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:8080
Mongo__Uri=mongodb://127.0.0.1:27017
Mongo__Database=warfriends
# Generate a random base64 32-byte key. Set the same value in both processes.
Battle__SigningKey=
# Distinct random base64 32-byte control-plane HMAC key. Required by the Worker;
# set the same value on Backend when allocation/result endpoints are enabled.
Battle__ControlKey=
# Backend -> Worker match registration URL (defaults to loopback ControlPort).
# Battle__ControlEndpoint=http://127.0.0.1:30001/internal/matches
# Required to enable the authenticated default matchmaking queue; chosen by deployment policy.
# Battle__MatchmakingCompatibilityKey=unscored-rifle-combat.default
# Operator-reviewed source-valid template; Backend replaces only match/player IDs and trusted allocations.
# Battle__MatchManifestTemplatePath=Server/content/local-rifle-match-template.json
# Optional Worker -> Backend terminal-result acceptance URL.
# Battle__BackendResultEndpoint=https://127.0.0.1:8080/internal/battle/results/accept
# Battle__BackendAllocationEndpoint=https://127.0.0.1:8080/internal/battle/allocations/read
Battle__ServerId=local-1
Battle__PublicHost=127.0.0.1
Battle__BindAddress=127.0.0.1
Battle__Port=30000
Battle__ControlPort=30001
# Use a persistent local volume in deployment. Terminal evidence is unscored until Backend settlement exists.
# Battle__ResultOutboxPath=/absolute/path/battle-result-outbox
# Optional unscored matches: choose one file OR a directory with 1-32 manifests.
# Battle__MatchManifestPath=/absolute/path/match.json
# Battle__MatchManifestDirectory=/absolute/path/matches
# Optional pinned source package; requires CatalogRevision plus both WeaponUpgrade indexes in every match.
# Required in both Backend and Worker when Battle__MatchManifestTemplatePath is enabled.
# Battle__CombatContentManifestPath=/absolute/path/Server/content/combat-content-manifest.json
# Battle__ShotgunContentManifestPath=/absolute/path/Server/content/shotgun-content-manifest.json
# Battle__SmgContentManifestPath=/absolute/path/Server/content/smg-content-manifest.json
# Battle__PistolContentManifestPath=/absolute/path/Server/content/pistol-content-manifest.json
# Battle__LmgContentManifestPath=/absolute/path/Server/content/lmg-content-manifest.json
# Battle__MinigunContentManifestPath=/absolute/path/Server/content/minigun-content-manifest.json
# Battle__SniperContentManifestPath=/absolute/path/Server/content/sniper-content-manifest.json
# Battle__BazookaContentManifestPath=/absolute/path/Server/content/bazooka-content-manifest.json
# Battle__GrenadeContentManifestPath=/absolute/path/Server/content/grenade-content-manifest.json
# Battle__ContentPath=/absolute/path/Server/content/recovered-battle-content.json
# Legacy channel for the recovered 1.4.0 Unity client (/index_09_25_2015.php, /check.php).
# The recovered Google2u economy catalog (same file Battle__ContentPath points at). Unset or
# missing leaves catalog-priced actions (ChangePlayerName, BuyWeapon, …) refusing rather than
# guessing; Gold/WarBucks/DogTagMax below then fall back to the unverified defaults on the right.
# Legacy__ContentPath=/absolute/path/Server/content/recovered-battle-content.json
# Server-owned starting state; the client's own StartingGold/StartingWarbucks are discarded.
# With Legacy__ContentPath set, Gold/WarBucks/DogTagMax already default to the catalog's real
# StartingGold=75/StartingWarbucks=15000/DogTagCap=5 — leave the three commented out unless you
# specifically want to override the catalog. Uncommented, they take precedence over it.
# Legacy__Starter__Gold=500
# Legacy__Starter__WarBucks=50
# Legacy__Starter__DogTagMax=10
Legacy__Starter__SessionLifetimeHours=24
# Sheet-configuration version reported to GetConfigurations. Bump only alongside real sheet
# documents in the response, or the client re-downloads nothing and logs a mismatch.
Legacy__Starter__SheetConfiguration=0
# Serves the legacy channel over plain HTTP, exposing credentials and session tokens.
# Offline/isolated networks only. Leave unset in any reachable deployment.
Legacy__AllowInsecureHttp=false
