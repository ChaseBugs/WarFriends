{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "min(up{job=\"warfriends\"})", "legendFormat": "targets", "refId": "A" }],
      "title": "Backend available",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (status_class) (rate(warfriends_http_requests_total[$__rate_interval]))", "legendFormat": "{{status_class}}", "refId": "A" }],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "sum(rate(warfriends_http_request_duration_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(warfriends_http_request_duration_seconds_count[$__rate_interval])), 0.001)", "legendFormat": "mean", "refId": "A" }],
      "title": "Mean HTTP processing time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(warfriends_websocket_connections)", "legendFormat": "connections", "refId": "A" },
        { "expr": "sum(rate(warfriends_websocket_messages_total[$__rate_interval]))", "legendFormat": "messages/s", "refId": "B" },
        { "expr": "sum(rate(warfriends_websocket_rate_limited_total[$__rate_interval]))", "legendFormat": "rejected/s", "refId": "C" }
      ],
      "title": "WebSocket traffic",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "warfriends_http_requests_in_flight", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "In-flight HTTP requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "warfriends_process_resident_memory_bytes", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Resident memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "bool" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 11 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "warfriends_redis_available", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Redis availability",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 11 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "100 * sum(rate(warfriends_http_requests_total{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(warfriends_http_requests_total[$__rate_interval])), 0.001)", "legendFormat": "5xx", "refId": "A" }],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 11 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "100 * sum(rate(warfriends_websocket_rate_limited_total[$__rate_interval])) / clamp_min(sum(rate(warfriends_websocket_messages_total[$__rate_interval])), 0.001)", "legendFormat": "rejected", "refId": "A" }],
      "title": "WebSocket rejection ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["warfriends", "backend"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "WarFriends Backend Overview",
  "uid": "warfriends-backend",
  "version": 1
}
