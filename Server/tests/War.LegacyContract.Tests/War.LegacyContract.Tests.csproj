<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LegacyContractPython Condition="'$(LegacyContractPython)' == '' and '$(OS)' == 'Windows_NT'">python</LegacyContractPython>
    <LegacyContractPython Condition="'$(LegacyContractPython)' == ''">python3</LegacyContractPython>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/War.Backend/War.Backend.csproj" />
    <None Include="../../docs/legacy-buffer-contracts.json" Link="legacy-buffer-contracts.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Test-only: use the recovered Client's actual JSON conversion behavior. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../../Clients/ExportedProject/Assets/Plugins/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>../../../Clients/AuxiliaryFiles/GameAssemblies/UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="GenerateRecoveredBufferOracle" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(LegacyContractPython)&quot; &quot;$(MSBuildProjectDirectory)/../../tools/generate_legacy_buffer_oracle.py&quot; --output &quot;$(IntermediateOutputPath)RecoveredClient.g.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RecoveredClient.g.cs" />
    </ItemGroup>
  </Target>
</Project>
